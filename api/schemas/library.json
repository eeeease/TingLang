{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Library",
  "description": "The official library: courses with their covers. Text only; media plays from where it is published.",
  "type": "object",
  "required": [
    "courses"
  ],
  "properties": {
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "courses": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "clip_count",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9._-]+$",
            "description": "The course's podcast_id; GET /library/{id} returns it."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "area": {
            "type": "string",
            "description": "Library area (podcasts, nba, life…); unknown values fall back to life."
          },
          "source_label": {
            "type": "string",
            "maxLength": 200,
            "description": "Where the media is published, e.g. \"Lex Fridman Podcast · YouTube\"."
          },
          "youtube_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{6,20}$"
          },
          "cover_url": {
            "type": "string",
            "format": "uri",
            "description": "A JPEG served by the same server."
          },
          "clip_count": {
            "type": "integer",
            "minimum": 1
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "learner_level": {
            "type": "string",
            "maxLength": 20
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Changes whenever the course changes, so the client can offer an update."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
